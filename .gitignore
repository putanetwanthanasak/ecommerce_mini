# Monorepo layout: backend/ and (soon) frontend/ each have their own node_modules,
# build output and .env. None of the patterns below start with a slash, so git
# matches them at ANY depth — backend/.env and frontend/node_modules/ are already
# covered. Adding a leading slash to any of these would silently un-ignore the
# workspace copies, so don't.

# Environment — covers backend/.env, frontend/.env
.env
.env.local
.env.*.local

# Dependencies — covers backend/node_modules/, frontend/node_modules/
node_modules/

# Build output — covers backend/dist/ (tsc) and frontend/dist/ (Vite)
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
Thumbs.db

# Claude Code local settings
.claude/


CODE_GUIDE.MD