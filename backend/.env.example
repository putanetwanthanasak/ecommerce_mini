# Copy this file to .env and fill in real values. Never commit .env itself.

# Get a free Postgres DB from Supabase, Neon, or Railway if you don't have one locally.
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_db"

# Used by Prisma Migrate only (prisma/schema.prisma -> directUrl). Locally, set it
# to the SAME value as DATABASE_URL — it only differs in production, where
# DATABASE_URL is a transaction-mode pooler that cannot hold Migrate's advisory
# lock. It has no default: Prisma fails with P1012 if it is missing.
DIRECT_URL="postgresql://user:password@localhost:5432/ecommerce_db"

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

PORT=4000
NODE_ENV=development

# Browser origins allowed to call this API, comma-separated. Requests with no
# Origin header (curl, health checks, Supertest) are always allowed — CORS is a
# browser mechanism and blocking them would only break tooling.
# Unset is fine in development: it falls back to the Vite dev server below.
# In production this MUST name the deployed frontend origin, or every request
# from it is blocked by the browser.
CORS_ORIGINS=http://localhost:5173
