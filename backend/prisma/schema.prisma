// Prisma schema for E-commerce mini platform
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime connection. In production this is Supabase's Supavisor pooler in
  // TRANSACTION mode (port 6543, ?pgbouncer=true) — see README "Deployment".
  url = env("DATABASE_URL")

  // Migrations only. Prisma Migrate takes a SESSION-level advisory lock, which
  // transaction-mode pooling cannot hold: `prisma migrate deploy` against port
  // 6543 hangs forever rather than failing (measured — it sat for 5 minutes
  // with no output). directUrl points migrations at a connection that can hold
  // that lock (session mode, port 5432), while the app keeps the pooled one.
  //
  // This is REQUIRED once declared — Prisma fails with P1012 "Environment
  // variable not found" if it is missing, with no fallback to url. That is why
  // .env.example, backend/.env and the CI job all define it. Locally and in CI
  // it is simply the same value as DATABASE_URL, because those are already
  // direct connections; only production needs the two to differ. The loud
  // failure is preferable to a silent one: forgetting it stops the build
  // instead of quietly migrating through the pooler and hanging.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@map("products")
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING)
  totalPrice Decimal     @db.Decimal(10, 2)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@map("orders")
}

// Junction table: stores price AT THE TIME OF PURCHASE
// (product.price can change later, but past orders must keep the original price)
model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
