// Prisma schema for E-commerce mini platform
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime connection. In production this is Supabase's Supavisor pooler in
  // TRANSACTION mode (port 6543, ?pgbouncer=true) — see README "Deployment".
  url = env("DATABASE_URL")

  // Migrations only. Prisma Migrate takes a SESSION-level advisory lock, which
  // transaction-mode pooling cannot hold: `prisma migrate deploy` against port
  // 6543 hangs forever rather than failing (measured — it sat for 5 minutes
  // with no output). directUrl points migrations at a connection that can hold
  // that lock (session mode, port 5432), while the app keeps the pooled one.
  //
  // This is REQUIRED once declared — Prisma fails with P1012 "Environment
  // variable not found" if it is missing, with no fallback to url. That is why
  // .env.example, backend/.env and the CI job all define it. Locally and in CI
  // it is simply the same value as DATABASE_URL, because those are already
  // direct connections; only production needs the two to differ. The loud
  // failure is preferable to a silent one: forgetting it stops the build
  // instead of quietly migrating through the pooler and hanging.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            Role             @default(CUSTOMER)
  orders          Order[]
  idempotencyKeys IdempotencyKey[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("users")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  // Optional: existing products predate this field and render with a fallback.
  // Stored as a bare URL string — there is no upload pipeline; it is set by the
  // seed script or an admin PATCH. Validated as a URL at the route boundary.
  imageUrl    String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@map("products")
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING)
  totalPrice Decimal     @db.Decimal(10, 2)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@map("orders")
}

// Idempotency ledger for POST /api/orders. The client sends an `Idempotency-Key`
// header (a UUID) once per checkout attempt and reuses it across retries; the
// first request for a given (userId, key) claims the row inside the order
// transaction, and any later request replays `responseStatus` / `responseBody`
// instead of placing a second order. See invariant 9 in CLAUDE.md and the
// detailed reasoning in src/routes/orders.ts.
//
// `responseStatus` / `responseBody` are nullable only for the instant between
// the claim INSERT and the response UPDATE, both of which run in the same
// transaction as the order write — a committed row therefore always carries the
// response of a committed order, and a rolled-back attempt leaves no row at all.
//
// `responseBody` is the exact serialized JSON of the original response, stored
// as text and replayed verbatim. It is NOT a `Json` column on purpose: Prisma's
// Json serializer renders `Decimal` as a JSON number, but the live route (and
// invariant 7) sends it as a JSON string, so round-tripping through `Json` would
// make a replay differ from the original. `JSON.stringify` of the order matches
// the live response byte for byte.
//
// Rows are safe to prune once older than the retry window a client could
// plausibly use (hours, not days). That pruning job is a known follow-up and is
// not built here.
model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())

  // Scoped per user, not global: one customer's key can never collide with or
  // pre-empt another's. This compound unique is the concurrency guard — two
  // racing retries contend on it and exactly one INSERT wins.
  @@unique([userId, key])
  @@index([key])
  @@map("idempotency_keys")
}

// Junction table: stores price AT THE TIME OF PURCHASE
// (product.price can change later, but past orders must keep the original price)
model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
